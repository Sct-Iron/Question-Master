rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.isSuperAdmin == true;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && ((request.resource.data.role == 'student' && request.resource.data.status == 'approved')
          || (request.resource.data.role == 'admin' && request.resource.data.status == 'pending'));
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /quizAnswerKeys/{quizId} {
      allow read, write: if false;
    }

    match /drafts/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId && isAdmin();
    }

    match /attempts/{attemptId} {
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;
      allow write: if false;
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (
        isAdmin() || (resource.data.studentId == request.auth.uid && resource.data.isReleased == true)
      );
      allow write: if false;
    }
  }
}
